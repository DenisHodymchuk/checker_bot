# Telegram Bot Token (отримайте у @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (отримайте безкоштовно на https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Хмарна база даних Supabase (рекомендовано для Railway, щоб не втрачати дані):
# Отримайте безкоштовно на https://supabase.com -> Project Settings -> API
SUPABASE_URL=
SUPABASE_KEY=

# Telegram ID адміністратора (ваш особистий числовий ID, дізнатися у @userinfobot)
ADMIN_ID=

# ID робочого групового чату (можна також налаштувати командою /set_group у самій групі)
GROUP_CHAT_ID=

# Часовий пояс (за замовчуванням Київ)
TIMEZONE=Europe/Kyiv
