# Google Таблиця (ID та GID вкладки) і URL веб-додатку Apps Script для автозапису
GOOGLE_SHEET_ID=1qWVTXOfVQzn9VLEUWdZvIOvZt_omcd8j0Yr5QilzNt4
GOOGLE_SHEET_GID=1261303835
